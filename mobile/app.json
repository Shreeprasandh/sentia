{
  "expo": {
    "name": "Sentia",
    "slug": "sentia-bag",
    "scheme": "sentia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sentia.smartliving",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Sentia connects to your smart bag via Bluetooth to monitor battery, sensors, and departures.",
        "NSLocationWhenInUseUsageDescription": "Sentia tracks your bag location to prevent leaving it behind.",
        "NSFaceIDUsageDescription": "Use Face ID to secure your Sentia profile and hardware locks."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/logo.png",
        "backgroundColor": "#FAF6EE"
      },
      "package": "com.sentia.smartliving",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/brand/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "87a44577-1cce-43b5-b167-64b361eebb43"
      }
    }
  }
}
